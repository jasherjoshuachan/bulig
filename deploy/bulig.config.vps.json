{
  "store": {
    "kind": "postgres",
    "urlEnv": "BULIG_PG_URL",
    "urlCredential": "pg-url"
  },
  "dbPath": "/var/lib/bulig/state/bulig.sqlite",
  "enabled": [
    "channel-cli",
    "gate-evidence",
    "gate-promise",
    "github",
    "pipeline-dev",
    "worker-gateway"
  ],
  "grants": {
    "channel-cli": [
      "channel.send:terminal",
      "approval.grant"
    ],
    "github": [
      "git.push",
      "gh.pr"
    ],
    "pipeline-dev": [
      "merge.request",
      "jobs.write"
    ],
    "worker-gateway": [
      "net.listen",
      "git.apply",
      "fs.worktree"
    ]
  },
  "pluginConfig": {
    "worker-gateway": {
      "listen": [
        "127.74.3.1",
        "198.18.74.1"
      ],
      "port": 7431,
      "workers": {
        "vps": {
          "credential": "worker-tokens",
          "slots": 2
        }
      }
    },
    "gate-evidence": {
      "mode": "warn",
      "enabled": true
    },
    "gate-promise": {
      "mode": "warn",
      "enabled": true
    },
    "github": {
      "tokenEnv": "BULIG_GH_TOKEN",
      "authorName": "Bulig Bot",
      "authorEmail": "<id>+<username>@users.noreply.github.com",
      "allowNoChecks": false
    },
    "pipeline-dev": {
      "models": {
        "strong": "opus",
        "standard": "sonnet"
      },
      "maxBuildAttempts": 2,
      "branchPrefix": "bulig",
      "keepFailedWorktrees": false,
      "scopeMode": "enforce",
      "scopeAlwaysAllow": [],
      "allowBroadScope": false
    }
  }
}
