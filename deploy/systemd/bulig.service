[Unit]
Description=Bulig kernel (bulig serve)
Documentation=https://github.com/jasherjoshuachan/bulig
# The kernel needs its own Postgres cluster up first. Wants, not Requires: if the cluster restarts, the kernel's lease logic
# handles the gap and a restart of this unit is not forced.
After=network-online.target postgresql@16-bulig.service
Wants=network-online.target postgresql@16-bulig.service
# No config, no start: a missing config would otherwise fall back to a SQLite file and run a second, empty record.
ConditionPathExists=/var/lib/bulig/.bulig/config.json
# A crash loop stops after 10 tries in 5 minutes instead of hammering the database.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# The kernel's own user. The worker (which runs Claude Code) is a different user in bulig-worker.service.
User=bulig
Group=bulig
WorkingDirectory=/opt/bulig/current
# Secrets come in as credentials: root-only files (0600), one secret each, found in $CREDENTIALS_DIRECTORY. This unit holds the database URL,
# the GitHub token and the table of worker tokens. It does NOT hold the Claude token: that goes only to bulig-worker.service, a different
# user. A missing file stops the unit from starting, on purpose. See deploy/credentials.example.
LoadCredential=pg-url:/etc/bulig/pg-url
LoadCredential=gh-token:/etc/bulig/gh-token
LoadCredential=worker-tokens:/etc/bulig/worker-tokens
# HOME is where the config lives ($HOME/.bulig/config.json), and where gh keeps its sign-in.
Environment=HOME=/var/lib/bulig
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/var/lib/bulig/.local/bin
ExecStart=/usr/bin/env node packages/cli/bin/bulig.mjs serve
# Always restart: serve exits non-zero when it loses the lease, and a fresh start resumes from the record.
Restart=always
RestartSec=5
# Give running work time to stop; after that the whole control group is killed.
TimeoutStopSec=60
KillMode=control-group
# Everything the kernel writes (repos, worktrees, state) is private to bulig.
UMask=0077

# Caps, so a runaway kernel cannot starve client production on the same host. (The worker has its own, in bulig-worker.service.)
MemoryMax=4G
CPUQuota=300%
TasksMax=512
# Under contention, client services win.
CPUWeight=50
Nice=10
LimitNOFILE=65536

# Hardening (same set as personal-credential-broker, minus what node and git need).
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
# Whole filesystem read-only except the line below (state, config, repos and worktrees under repos/, ~/.config/gh).
ProtectSystem=strict
ReadWritePaths=/var/lib/bulig
# /home and /root become read-only. The bulig home (/var/lib/bulig) is outside them and is in ReadWritePaths.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Other users' processes are hidden. ProcSubset=pid is NOT set: node reads /proc/meminfo and /proc/cpuinfo.
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# NOT set on purpose:
#   MemoryDenyWriteExecute  node's JIT needs writable+executable memory.
#   /opt/bulig writable     releases are installed by release.sh and handed back to root; the service never rewrites its own code.

[Install]
WantedBy=multi-user.target
