#!/usr/bin/env bash
# A git credential helper for the Bulig users (ADR 0011). git runs it as the user's own process, with the user's own $CREDENTIALS_DIRECTORY:
#   git config --global credential.https://github.com.helper '!/usr/local/lib/bulig/current/git-credential-bulig-read <credential>'
# <credential> is the name of a credential file the unit loaded: github-read-token for the worker (read-only, one repository), gh-token for the
# kernel. Nothing else is accepted, so a changed config cannot point this at another file.
# On "get" for https://github.com it prints the two lines git wants, and nothing else:
#   username=x-access-token
#   password=<the token>
# The token is read from $CREDENTIALS_DIRECTORY at the moment git asks. It is never written into a git config or a remote URL, never put in an
# argument or the environment (printf is a shell builtin), and never printed to stderr. "store" and "erase" do nothing: git must not keep it.
set -u
umask 0077

op="${2:-}"
name="${1:-}"
case "$name" in
  github-read-token | gh-token) ;;
  *)
    echo "git-credential-bulig-read: usage: git-credential-bulig-read <github-read-token|gh-token> get" >&2
    exit 2
    ;;
esac
[ "$op" = "get" ] || exit 0

# git sends "key=value" lines on stdin. Answer only for https://github.com.
protocol="" host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
  esac
done
[ "$protocol" = "https" ] && [ "$host" = "github.com" ] || exit 0

dir="${CREDENTIALS_DIRECTORY:-}"
if [ -z "$dir" ] || [ ! -r "$dir/$name" ]; then
  echo "git-credential-bulig-read: credential '$name' is not loaded in this unit" >&2
  exit 0
fi
token=""
IFS= read -r token <"$dir/$name" || true
# "none" is the unit's SetCredential= default when no token file was installed: answer nothing, as with no credential.
if [ "$token" = "none" ]; then
  echo "git-credential-bulig-read: credential '$name' is not set on this server (no token file)" >&2
  exit 0
fi
# A token is letters, digits, underscore, dot and dash. Anything else (an empty file, a space, a control character) could add a line to what
# git reads back, so it is refused without being shown.
if ! [[ "$token" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "git-credential-bulig-read: credential '$name' is empty or not a token" >&2
  exit 0
fi
printf 'username=x-access-token\npassword=%s\n' "$token"
