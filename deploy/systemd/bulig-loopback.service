[Unit]
Description=Bulig gateway loopback address (127.74.3.1 on lo)
Documentation=https://github.com/jasherjoshuachan/bulig
# The worker and the kernel talk over 127.74.3.1. A connection to a loopback address that is not assigned to lo as its own address carries
# source 127.0.0.1 (the route says "src 127.0.0.1"), and each unit's IP filter would then have to let 127.0.0.1 through, which is where other
# tenants' services listen. With 127.74.3.1/32 on lo the source is 127.74.3.1 too, so each side allows exactly that one address.
# This adds one address alias to lo. Nothing else on the host's network is touched. It goes away when the unit stops.
Before=bulig.service bulig-worker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# "replace" makes a second start harmless. /usr/bin/ip on this host (/usr/sbin/ip is a link to it).
ExecStart=/usr/bin/ip address replace 127.74.3.1/32 dev lo
ExecStop=/usr/bin/ip address del 127.74.3.1/32 dev lo
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_NETLINK AF_UNIX
# It sends no IP packets at all.
IPAddressDeny=any
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
